# Copia este archivo como .env
#
# Modo simulado (por defecto): la app usa la API falsa que vive en server/api
NUXT_PUBLIC_API_BASE=/api
# API simulada y atajos de rol en el login. En desarrollo ya está activa; en un build
# de producción está apagada salvo que se ponga en true (ej. demo en LAN con datos falsos).
# NUXT_PUBLIC_MODO_SIMULADO=true
# Solo funciona con "npm run build" + Node (node .output/server/index.mjs).
# Con "nuxt generate" no hay servidor, así que server/api no existe y la API simulada no responde.

# Cuando B publique la API real, cambia la línea de arriba por:
# NUXT_PUBLIC_API_BASE=http://localhost:5080/api
